<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xunit v3 test projects are standalone executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions are taken once they have been out for a couple of weeks, not on release
         day. Test.Sdk 18 dropped its Newtonsoft.Json dependency; nothing here relied on it.
         xunit.v3.mtp-off is xunit v3 without Microsoft Testing Platform: the plain xunit.v3
         4.x package defaults to MTP v2, and on the .NET 10 SDK `dotnet test` then refuses
         the VSTest path unless global.json switches the whole repository to MTP mode —
         which would also mean replacing coverlet.collector. VSTest, through
         xunit.runner.visualstudio, keeps `dotnet test` and CI exactly as they were. -->
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SystemBarIndicator.Core\SystemBarIndicator.Core.csproj" />
  </ItemGroup>

</Project>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xunit v3 test projects are standalone executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions are taken once they have been out for a couple of weeks, not on release
         day.
         Tests run on Microsoft Testing Platform v2, not VSTest: global.json at the
         repository root puts `dotnet test` into MTP mode, and the test exe itself is the
         runner. The explicit xunit.v3.mtp-v2 package (rather than xunit.v3, whose default
         happens to be MTP v2 today) keeps a future default change from switching the
         platform silently. Microsoft.NET.Test.Sdk and xunit.runner.visualstudio are VSTest
         pieces and are gone; coverlet.MTP replaces the VSTest-only coverlet.collector.
         Coverage is opt-in: see "Build and test" in the README for the command. -->
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SystemBarIndicator.Core\SystemBarIndicator.Core.csproj" />
  </ItemGroup>

</Project>